{
    "name": "ace-field-options",
    "version": "0.420.0",
    "description": "Example block scaffolded with Create Block tool.",
    "author": "Shane Rounce",
    "license": "GPL-2.0-or-later",
    "main": "assets/js/index.js",
    "scripts": {
        "build": "npm-run-all clean-assets build-js build-css",
        "build-js": "wp-scripts build",
        "dev-js": "wp-scripts start --watch",
        "build-css": "sass src/styles/scss:assets/styles --no-source-map",
        "clean-assets": "rm -rf assets/js && mkdir -p assets/js",
        "watch-css": "chokidar 'src/**/*.scss' -c 'npm run build-css'",    
        "format": "wp-scripts format",
        "lint:css": "wp-scripts lint-style",
        "lint:js": "wp-scripts lint-js",
        "packages-update": "wp-scripts packages-update",
        "plugin-zip": "wp-scripts plugin-zip",
         "start": "npm-run-all dev-js watch-css"
    },
    "devDependencies": {
        "@wordpress/icons": "^10.10.0",
        "@wordpress/scripts": "^30.3.0",
        "chokidar-cli": "^3.0.0",
        "css-loader": "^7.1.2",
        "npm-run-all": "^4.1.5",
        "sass": "^1.80.4",
        "sass-loader": "^16.0.2",
        "style-loader": "^4.0.0"
    },
    "files": [
        "README.md",
        "ace-field-options.php",
        "assets"
    ]
}
