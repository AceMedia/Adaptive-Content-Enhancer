{
    "name": "ace-field-options",
    "version": "0.1.0",
    "description": "Example block scaffolded with Create Block tool.",
    "author": "Shane Rounce",
    "license": "GPL-2.0-or-later",
    "main": "build/index.js",
    "scripts": {
        "build": "wp-scripts build --config ./webpack.config.js && npm run build-css",
        "build-css": "sass src/styles/scss:assets/styles/css --no-source-map",
        "watch-css": "nodemon --watch src/styles/scss --ext scss --exec \"npm run build-css\"",
        "format": "wp-scripts format",
        "lint:css": "wp-scripts lint-style",
        "lint:js": "wp-scripts lint-js",
        "packages-update": "wp-scripts packages-update",
        "plugin-zip": "wp-scripts plugin-zip",
        "start": "wp-scripts start --config ./webpack.config.js"
    },
    "devDependencies": {
        "@wordpress/scripts": "^30.1.0",
        "sass": "^1.32.0"
    }
}
